# Backend - TaskFlow
# Copia este archivo a .env y ajusta los valores.
# Nunca subas claves reales al repositorio.

# Configuración de la aplicación
APP_NAME=TaskFlow
DEBUG=True

# Base de datos SQLite (ruta relativa al ejecutar desde backend/)
DATABASE_URL=sqlite:///./taskflow.db

# CORS - Orígenes permitidos del frontend
BACKEND_CORS_ORIGINS=http://localhost:5173

# OpenRouter (configurado por el usuario desde los ajustes de TaskFlow)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
